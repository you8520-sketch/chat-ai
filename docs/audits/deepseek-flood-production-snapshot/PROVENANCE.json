  "production_db_source_when_proven": {
    "path": "/data/app.db",
    "proof": "RAILWAY_ENVIRONMENT_NAME=production AND (RAILWAY_VOLUME_MOUNT_PATH=/data OR DATA_DIR=/data)"
  },
