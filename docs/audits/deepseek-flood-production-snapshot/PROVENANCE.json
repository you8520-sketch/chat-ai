    },
    {
      "id": "GET /api/admin/regen-context",
      "reason": "ADMIN_DEBUG_TOKEN accepted; returns message-id traces only, not character/persona prompt fields"
    },
    {
      "id": "GET /api/admin/status-widget-diagnostics",
      "reason": "status-widget values only"
    },
    {
      "id": "GET /api/admin/character-moderation",
      "reason": "session admin required; returns listing metadata; official characters excluded; no system_prompt"
    },
    {
      "id": "GET /api/admin/full-db-migration",
      "reason": "FULL_DB_MIGRATION_TOKEN is not present in production variables"
    },
    {
      "id": "GET /api/characters/:id",
      "reason": "owner session required; not an admin audit path"
    },
    {
      "id": "PROMPT_DEBUG dump",
      "reason": "writes assembled prompts on the production volume during live chat; not a targeted character/persona snapshot and not invoked"
    }
  ],
  "new_exporter": {
    "module": "src/lib/handoffAuditExport.ts",
    "http": "GET /api/admin/handoff-audit-export",
    "default": "HANDOFF_AUDIT_EXPORT_ENABLED=false",
    "auth": "ADMIN_DEBUG_TOKEN via x-admin-debug-token or Bearer",
