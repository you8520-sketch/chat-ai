  "ADMIN_PERSONA_PRODUCTION_RECORD_PROVEN": false,
  "PRODUCTION_LOADERS_REUSED": [
    "getDb().prepare('SELECT * FROM characters WHERE id = ?')",
    "loadCharacterChunksForPromptReadOnly",
