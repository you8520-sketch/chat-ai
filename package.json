{
  "name": "hav-chat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "open": "powershell -NoProfile -Command \"Start-Process 'http://localhost:3000'\"",
    "dev:safe": "tsx scripts/dev-server.ts",
    "dev:next": "next dev -p 3001",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "lint": "npm run typecheck:app",
    "test:regular": "node --conditions=react-server --import tsx --import ./src/lib/test/regularTestEgressPolicy.ts --test \"src/**/*.test.ts\"",
    "test:ui": "playwright test",
    "build": "next build",
    "start": "tsx server.js",
    "start:next": "next start",
    "payout:run": "tsx scripts/run-payout-once.ts",
    "official-supply:pilot-author": "node --conditions=react-server --import tsx scripts/official-supply-pilot-author.ts",
    "training:analyze": "tsx scripts/training-daily-analysis.ts",
    "training:export": "tsx scripts/training-weekly-export.ts",
    "dump:system-prompt": "tsx scripts/dump-system-prompt.ts",
    "prod": "npm run build && npm run start",
    "prod:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/run-prod.ps1",
    "official-supply:style-proof": "node --conditions=react-server --import tsx scripts/official-supply-style-proof.ts",
    "official-supply:cluster-b-v4-style-proof": "node --conditions=react-server --import tsx scripts/official-supply-cluster-b-v4-style-proof.ts",
    "official-supply:generate-rofan-v4-anchors": "node --conditions=react-server --import tsx scripts/official-supply-generate-rofan-v4-anchors.ts",
    "official-supply:approve-anchor": "node --conditions=react-server --import tsx scripts/official-supply-approve-anchor.ts",
    "official-supply:generate-lucian-variations": "node --conditions=react-server --import tsx scripts/official-supply-generate-lucian-variations.ts",
    "audit:main-rp-monthly-cache": "node --conditions=react-server --import tsx scripts/main-rp-monthly-cache-audit.ts",
    "test:main-rp-monthly-cache-audit": "node --conditions=react-server --import tsx --test scripts/lib/mainRpMonthlyCacheAudit.test.ts",
    "audit:code-health": "node --conditions=react-server --import tsx scripts/code-health-audit.ts",
    "audit:code-health-cleanup": "node --conditions=react-server --import tsx scripts/code-health-monthly-cleanup.ts",
    "test:code-health-audit": "node --conditions=react-server --import tsx --import ./src/lib/test/regularTestEgressPolicy.ts --test --test-concurrency=1 \"src/lib/codeHealth/*.test.ts\""
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "@portone/browser-sdk": "^0.1.8",
    "@vercel/blob": "^2.8.0",
    "better-sqlite3": "npm:libsql@^0.5.0",
    "isomorphic-dompurify": "^3.3.0",
    "next": "^15.5.24",
    "node-cron": "^4.2.1",
    "openai": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tsx": "^4.22.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "@types/web-push": "^3.6.4",
    "jsdom": "25.0.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5"
  },
  "overrides": {
    "jsdom": "25.0.1",
    "dompurify": "3.4.15",
    "esbuild": "0.28.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "@vercel/blob": {
      "undici": "6.28.1"
    }
  }
}
