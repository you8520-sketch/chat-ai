# OpenRouter API 키 (채팅·백그라운드 기억·비전 등 전체 LLM)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# PWA Web Push — optional. If these are empty, the server generates a stable
# VAPID key pair on first boot and stores it in app_meta (same persistent DB
# as sessions). Set DISABLE_WEB_PUSH=1 to keep push off.
# To pin keys yourself: npx web-push generate-vapid-keys --json
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
# DISABLE_WEB_PUSH=1

# Cheaper Inference 직접 채팅 (Claude Opus 5)
# https://cheaperinference.com/
CHEAPER_INFERENCE_API_KEY=

# World-only TRPG Sandbox Blueprint (deepseek-v4-flash-0731). Default off.
# Scenario Draft AI and authored Scenario campaigns ignore this flag.
# TRPG_SANDBOX_DIRECTOR_ENABLED=1
# Live-round Flash mechanics referee + server damage/heal/ongoing. Default off.
# TRPG_MECHANICS_REFEREE_ENABLED=1
# Party premium + creator-funding addon. Default off; keep current production charge.
# TRPG_VALUE_PRICING_ENABLED=1
# Server-only campaign snapshot 502 diagnostics. Do not prefix NEXT_PUBLIC_.
# When unset: no diagnostic logs and no behavioral difference.
# TRPG_SNAPSHOT_DIAGNOSTICS=1

# Adult scene model handoff
# Chat-room 「성인모드」 (chats.adult_handoff_enabled) is the user-facing
# enablement. Home/header 「성인 캐릭터 표시」(users.nsfw_on) is listing
# visibility only and does not turn handoff on or off.
# ADULT_SCENE_HANDOFF_GENERAL_ENABLED remains a server-side force-on.
ADULT_SCENE_ROUTING_ENABLED=true
ADULT_SCENE_HANDOFF_ADMIN_CANARY=false
ADULT_SCENE_HANDOFF_GENERAL_ENABLED=false
# Comma-separated numeric IDs. Both allowlists must match for the admin canary.
ADULT_SCENE_HANDOFF_ADMIN_USER_IDS=
ADULT_SCENE_HANDOFF_ADMIN_CHAT_IDS=
# Legacy Aion primary — keep false (FINAL_ADULT_MODEL = deepseek-v4-pro).
ADULT_SCENE_AION_PRIMARY_ENABLED=false
ADULT_SCENE_GLM_HARD_FAILURE_FALLBACK_ENABLED=true
ADULT_SCENE_MODEL_POLICY_ADMIN_ONLY=false
ADULT_MODEL_ID=deepseek-v4-pro
# Comma-separated CheaperInference provider routing values. Leave blank until validated.
ADULT_MODEL_PROVIDER_ORDER=
ADULT_MODEL_PROVIDER_ONLY=
ADULT_MODEL_ALLOW_PROVIDER_FALLBACKS=false
ADULT_MODEL_REQUIRE_PARAMETERS=true
ADULT_MODEL_QUANTIZATIONS=
ADULT_SCENE_BASE_RAW_EXCHANGES=4
ADULT_SCENE_HANDOFF_TARGET_RAW_EXCHANGES=6
ADULT_SCENE_HANDOFF_EXTRA_RAW_TOKENS=4000
# Legacy aliases remain accepted during migration:
# ADULT_SCENE_HANDOFF_RAW_TURNS=6
# ADULT_SCENE_HANDOFF_MAX_TOKENS=4000
ADULT_SCENE_MINIMUM_ROUTE_TURNS=3
ADULT_SCENE_RETURN_SAFE_TURNS=2
ADULT_SCENE_SILENT_REFUSAL_FALLBACK=true
ADULT_SCENE_INITIAL_STREAM_BUFFER_CHARS=400
# Optional JSON override, for example:
# ADULT_SCENE_PROVIDER_CAPABILITIES_JSON={"anthropic":"tension","google":"tension","openai":"tension","deepseek":"explicit"}

# Phase B1-B — RP numeric state shadow observer (diagnostic only; default OFF).
# Fail-closed: ENABLED=1 still requires a non-empty valid USER_IDS allowlist.
# Does not write rp_numeric_state_* / does not alter status snapshots.
RP_NUMERIC_STATE_SHADOW_ENABLED=0
RP_NUMERIC_STATE_SHADOW_USER_IDS=
# Optional; when set, characterId must also match.
RP_NUMERIC_STATE_SHADOW_CHARACTER_IDS=

# Phase B1-C/D1 — Canonical server-authoritative numeric state (default OFF).
# Independent from SHADOW_* flags (shadow keep its own allowlists).
# When ENABLED=1 and KILL_SWITCH!=1, all authenticated users are eligible.
# Field scope is still explicit numericState + pilot keys only (affection/trust/corruption).
# Private-beta Railway target: ENABLED=1, KILL_SWITCH=0.
RP_NUMERIC_STATE_ENABLED=0
RP_NUMERIC_STATE_KILL_SWITCH=0

# OpenAI 직접 Images API (SD 고정틀·컷만화)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2

# 로컬 개발: 캐릭터 노출 이미지 검수 건너뛰기 (1|true|yes)
# SKIP_ASSET_MODERATION=1
# 백그라운드 비전 — 이미지 검열·에셋 태그 (DeepSeek V3 vision 미지원)
# BACKGROUND_VISION_MODEL=google/gemini-2.0-flash-001
# ASSET_VISION_MODEL=google/gemini-2.0-flash-001
# ASSET_VISION_MODEL_FALLBACK=qwen/qwen3-vl-8b-instruct
# 공개 캐릭터 노출 이미지 검수 (미설정 시 BACKGROUND_VISION_MODEL, 실패 시 Qwen3-VL-8B)
# ASSET_MODERATION_MODEL=google/gemini-2.0-flash-001
# ASSET_MODERATION_MODEL_FALLBACK=qwen/qwen3-vl-8b-instruct

# OpenRouter Claude Opus (claude-3-opus는 OpenRouter endpoint 없음 → 4.5 사용)
OPENROUTER_MODEL=anthropic/claude-opus-4.5
# OpenRouter 권장 헤더 (선택)
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=PlayAI
# OpenRouter 과금: dev 고정 20P는 fixed
# OPENROUTER_BILLING_MODE=fixed
# Claude Opus — 출력 1자당 0.142P (마진·원가 블렌드 없음) · UI 기본 숨김
# OPENROUTER_OPUS_USER_SELECTABLE=1
# Claude Opus 5 user chat — TEMPORARY DISABLE (CI prompt cache not applying).
# Re-enable picker + chat with OPUS5_USER_ENABLED=1. Does not overwrite stored selected_ai.
# OPUS5_USER_ENABLED=1
# OPENROUTER_OPUS_POINTS_PER_CHAR=0.142
# Interactive user-impersonation detector: log only by default (no extra API repair)
# USER_IMPERSONATION_AUTO_REPAIR=false

# Persona secret system (Boundary + Discovery). Default ON for all accounts when unset.
# Set either flag to 0 for a global kill switch. Discovery never outruns Boundary.
# PERSONA_SECRET_BOUNDARY_ENABLED=1
# PERSONA_SECRET_DISCOVERY_ENABLED=1
# Same-generation S4 live producer rollout gate. Default OFF; exact 1 enables.
# PERSONA_SECRET_S4_LIVE_PRODUCER_ENABLED=0

# Qwen 3.7 — 출력 1토큰당 0.062P · 면제 시 최소 50P
# OPENROUTER_QWEN_POINTS_PER_OUTPUT_TOKEN=0.062
# Muse Spark 1.1 — dual-rate simple point, 60% 목표 마진
# OPENROUTER_MUSE_GROSS_MARGIN=0.6
# Gemini 3.6 Flash — dual-rate simple point, 45% 목표 마진
# OPENROUTER_GEMINI_36_GROSS_MARGIN=0.45
# Gemini 3.1 Pro — 출력 1토큰당 0.075P · 면제 시 최소 65P
# OPENROUTER_GEMINI_31_POINTS_PER_OUTPUT_TOKEN=0.075
# Gemini 3.7 Flash — Cheaper Inference exact id only. User price ignores cache/upstream.
# GEMINI37_BASE_POINTS=45
# GEMINI37_INCLUDED_INPUT_TOKENS=25000
# GEMINI37_INPUT_STEP_TOKENS=10000
# GEMINI37_INPUT_STEP_POINTS=5
# GEMINI37_OUTPUT_TIER_2500=0
# GEMINI37_OUTPUT_TIER_4000=15
# GEMINI37_OUTPUT_TIER_5500=25
# GEMINI37_OUTPUT_TIER_7000=35
# GEMINI37_OUTPUT_TIER_9000=45
# GEMINI37_OUTPUT_OVER_9000_STEP_TOKENS=1500
# GEMINI37_OUTPUT_OVER_9000_STEP_POINTS=10
# Gemini Pro RP — provider.google.thinking type none (Pro 모델 직접 호출, Flash 우회 없음)
# DeepSeek V4 — 출력 1토큰당 0.022P · 면제 시 최소 20P
# OPENROUTER_DEEPSEEK_POINTS_PER_OUTPUT_TOKEN=0.022
# 입력 10,000토큰 초과분 — 1,000토큰당 1P 추가 (DeepSeek 제외)
# OPENROUTER_INPUT_SURCHARGE_PER_1000_TOKENS=1
# DeepSeek — 입력 10k 초과분 1,000토큰당 0.5P (비례, 중간 올림 없음)
# OPENROUTER_DEEPSEEK_INPUT_SURCHARGE_PER_1000_TOKENS=0.5
# cache_read_tokens → 입력 단가 10% (90% 할인), cache_write → 125%

# 백그라운드 기억·요약·상태창·번역 등 — Cheaper Inference GPT-5.6 Luna
BACKGROUND_MEMORY_MODEL=gpt-5.6-luna
# Creative OOC HTML 전용 primary — task-specific owner (default Luna; does not inherit BACKGROUND_MEMORY_MODEL)
# BACKGROUND_CREATIVE_HTML_MODEL=gpt-5.6-luna
# Historical DeepSeek Flash / V3 primary env aliases are migrated in-process to Luna.
# Explicit fallback model ids are not migrated (DeepSeek stays DeepSeek).
# Failure-only fallback after Cheaper Inference Luna fails.
# Blank/unset and the legacy V3 fallback value normalize to OpenRouter DeepSeek V4 Flash.
# BACKGROUND_MEMORY_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
# Memory, rolling summary, lorebook compression, and status extraction omit app-level input/output token caps.
# 캐릭터 설정 KO→EN 번역 (미설정 시 CI Luna → CI Pro 0813)
# Primary and fallback must resolve to different models.
# PROMPT_TRANSLATION_MODEL=gpt-5.6-luna
# PROMPT_TRANSLATION_FALLBACK_MODELS=deepseek-v4-pro-0813
# Character-save KO→EN translation caps: input 20000 / output 15000 (not RP max_tokens)

# 실제 API 원가 USD→KRW: daily_kst(KST 자정 고정, 기본) | realtime(1h 캐시)
# EXCHANGE_RATE_MODE=daily_kst
# EXCHANGE_RATE_FALLBACK_KRW=1500

# Dry-run — 실제 OpenRouter HTTP 차단 (1|true|yes). debug_payload.json에 payload 기록
# MOCK_MODE=1
# MOCK_FINISH_REASON=STOP
# MOCK_FINISH_REASON=MAX_TOKENS

# 장기기억 시스템 전체 비활성 (0|false|no|off)
# MEMORY_FEATURE_ENABLED=0

# SceneDirective Event-Restraint V2 (off|shadow|on). Default off — production unchanged.
# shadow: inject V1/Living, compute V2 + telemetry only. on: inject V2.
# SCENE_DIRECTIVE_V2_MODE=off

# Terra main-home prompt canary (default OFF). Allowlisted users only.
# Requires: ENABLED=true AND user id in USER_IDS AND model=gpt-5.6-terra AND single_primary.
# Variants:
#   baseline
#   greeting_neutral
#   scene_relation_priority
#   greeting_neutral_scene_relation_priority
#   greeting_neutral_relationship_axis
#   dialogue_intent_unit
#   greeting_neutral_card_dialogue_neutral
#   greeting_neutral_scene_card_dialogue_neutral
#   terra_dialogue_intent_adapter
#   greeting_neutral_scene_terra_dialogue_intent
#   final_main_home_candidate
# Optional Terra temperature override for allowlisted canary only (unset = production 0.7).
# TERRA_PROMPT_CANARY_TEMPERATURE=0.7
# TERRA_PROMPT_CANARY_ENABLED=false
# TERRA_PROMPT_CANARY_USER_IDS=
# TERRA_PROMPT_CANARY_VARIANT=baseline|dialogue_root_baseline|greeting_dialogue_bundled|terminal_continuous_scene|dialogue_reference_scope|greeting_terminal_combined|best_structure_temp_05|best_structure_temp_06
# TERRA_PROMPT_CANARY_DEBUG=false

# example_dialog 비어 있을 때 style-neutral structure fallback 주입 (기본 OFF — 1|true|yes|on)
# NARRATION_FEWSHOT_FALLBACK_ENABLED=1

# Narration-lexicon speech-lock (post-output rewrite). Off unless =1.
# SPEECH_LOCK_NARRATION_LEXICON=1
# Staging allowlist (comma-separated character names). Empty/unset = off even when flag=1.
# SPEECH_LOCK_NARRATION_LEXICON_CHARS=CharacterName
# Widen to all characters: SPEECH_LOCK_NARRATION_LEXICON_LEON_ONLY=0

# 구글 간편 로그인
# 승인된 리디렉션 URI (Google Console): http://localhost:8092/api/auth/google/callback
# 브라우저는 localhost로 접속 — 0.0.0.0은 Google OAuth에서 거부됩니다.
# NEXTAUTH_URL=http://localhost:8092
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PortOne V2 (포인트 충전) — 클로즈베타: 결제 비활성화
NEXT_PUBLIC_PORTONE_STORE_ID=iamporttest_3
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-a55bc529-05f2-47f4-b5a2-210456320fcb
PORTONE_CHARGE_ENABLED=0
NEXT_PUBLIC_PAYMENTS_ENABLED=0
# 클로즈베타: 성인인증 생략 (1|true|yes). 미설정 시 PORTONE_CHARGE_ENABLED=0이면 자동 생략
# SKIP_ADULT_VERIFICATION=1

# Railway persistent SQLite — mount volume at /data
# DATA_DIR=/data
# Production runtime must use a persistent DATA_DIR (or mounted /data) so SQLite sessions survive deploys/restarts.

# Vercel/serverless persistent SQLite — connect a Turso database instead of DATA_DIR.
# Configure the URL with one auth token variable. Never expose the token to browser code.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# Vercel Marketplace uses TURSO_DATABASE_TURSO_AUTH_TOKEN instead.
# TURSO_DATABASE_TURSO_AUTH_TOKEN=

# Stable server-side secrets (generate once and keep fixed in production)
# SESSION_SECRET=replace-with-32-plus-random-bytes
# WITHDRAWAL_ENCRYPTION_KEY=replace-with-32-plus-random-bytes

# OPENROUTER_HTTP_REFERER=https://your-app.up.railway.app
# 결제 조회·검증 — 포트원 콘솔 V2 API Secret (서버 전용)
# PORTONE_API_SECRET=
# PORTONE_CHARGE_ENABLED=1

# 관리자 — 이메일 화이트리스트(쉼표 구분) 또는 DB users.is_admin=1
# npx tsx scripts/set-admin.ts --email you@example.com
# ADMIN_EMAILS=you@example.com,ops@example.com
# 정산 CSV export API — x-admin-secret 헤더 (선택)
# ADMIN_EXPORT_SECRET=

# 크리에이터 출금: 프로덕션에서는 스케줄러를 켜 두세요 (매월 15일 03:00 KST 일괄 지급).
# DISABLE_PAYOUT_SCHEDULER=1  이면 자동 지급이 멈춥니다. 개발 서버는 기본 꺼짐.
# ENABLE_PAYOUT_SCHEDULER=1   개발에서만 스케줄러를 다시 켭니다.
# PAYOUT_RUN_ON_BOOT=1        기동 시 대기 큐 1회 즉시 실행 (개발용)

# Episodic memory: MEMORY_FEATURE_ENABLED (default on) turns rolling summary,
# episodic save, and episodic recall on together.
# Emergency recall kill switch only (negative):
# EPISODIC_MEMORY_RECALL_DISABLED=1
# Legacy: EPISODIC_MEMORY_RECALL_ENABLED=0 still disables recall for compatibility.
# One-shot 6→5 summary rebuild worker throughput (not a memory-policy flag):
# MEMORY_SUMMARY_MIGRATION_CONCURRENCY=1
